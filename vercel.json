{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/soroban", "destination": "/soroban/", "permanent": false }, { "source": "/dot", "destination": "/dot/", "permanent": false }],
  "rewrites": [{ "source": "/((?!soroban/|dot/|api/).*)", "destination": "/" }]
}
